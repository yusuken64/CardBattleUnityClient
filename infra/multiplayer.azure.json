{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": { "type": "string" },
    "githubRepository": { "type": "string", "defaultValue": "yusuken64/CardBattleUnityClient" },
    "location": { "type": "string", "defaultValue": "[resourceGroup().location]" }
  },
  "variables": {
    "planName": "[concat(parameters('appName'), '-plan')]",
    "identityName": "[concat(parameters('appName'), '-github')]",
    "websiteContributorRole": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'de139f84-1756-47ae-9be6-808fbbe84772')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": { "name": "B1", "tier": "Basic", "capacity": 1 },
      "properties": { "reserved": true }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "dependsOn": ["[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "DOTNETCORE|8.0",
          "appCommandLine": "dotnet GameServer.dll",
          "alwaysOn": true,
          "webSocketsEnabled": true,
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled"
        }
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('identityName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
      "apiVersion": "2023-01-31",
      "name": "[concat(variables('identityName'), '/github-multiplayer-production')]",
      "dependsOn": ["[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"],
      "properties": {
        "issuer": "https://token.actions.githubusercontent.com",
        "subject": "[concat('repo:', parameters('githubRepository'), ':environment:multiplayer-production')]",
        "audiences": ["api://AzureADTokenExchange"]
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Web/sites', parameters('appName')), variables('identityName'), variables('websiteContributorRole'))]",
      "scope": "[concat('Microsoft.Web/sites/', parameters('appName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('websiteContributorRole')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "clientId": { "type": "string", "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').clientId]" },
    "tenantId": { "type": "string", "value": "[subscription().tenantId]" },
    "subscriptionId": { "type": "string", "value": "[subscription().subscriptionId]" },
    "serverUrl": { "type": "string", "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01').defaultHostName)]" }
  }
}
